{
  "expo": {
    "name": "AthleteN",
    "slug": "AthleteN-Mobile",
    "version": "1.0.5",
    "orientation": "default",
    "icon": "./assets/logo.webp",
    "scheme": "athleten",
    "userInterfaceStyle": "dark",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#05070B",
        "foregroundImage": "./assets/logo.webp"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.novacode.athleten",
      "versionCode": 6
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-web-browser",
        {
          "experimentalLauncherActivity": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05070B",
          "image": "./assets/logo.webp",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      "expo-notifications",
      "expo-secure-store",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "AthletePulse",
              "label": "AthleteN • Athlete Pulse",
              "description": "Your training streak and sessions this week.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen"
            },
            {
              "name": "TrainingPlanner",
              "label": "AthleteN • Training Planner",
              "description": "Your next training session and daily focus.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen"
            },
            {
              "name": "CompetitionCountdown",
              "label": "AthleteN • Competition Countdown",
              "description": "Countdown to your next competition.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "7f308f88-5459-4f51-bb76-981f381eee3c"
      }
    },
    "ios": {
      "bundleIdentifier": "com.novacode.athleten"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "enabled": false,
      "url": "https://u.expo.dev/7f308f88-5459-4f51-bb76-981f381eee3c",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    }
  }
}
